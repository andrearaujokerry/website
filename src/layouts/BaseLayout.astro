---
import { Font } from 'astro:assets';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { site } from '../site.config';
import '../styles/tokens.css';
import '../styles/global.css';

interface Props {
  title?: string;
  description: string;
  /** Keep the page out of search results. */
  noindex?: boolean;
}

const { title = site.name, description, noindex = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <!-- Preload only what the first screen needs: the regular serif (headline) and the sans (body). -->
    <Font cssVariable="--font-serif" preload={[{ weight: 400, style: 'normal' }]} />
    <Font cssVariable="--font-sans" preload />
    <script is:inline>
      // Apply the saved theme, or the OS theme, before first paint so it never flashes.
      (() => {
        const root = document.documentElement;
        root.classList.add('js');
        let theme = null;
        try {
          theme = localStorage.getItem('theme');
        } catch {
          // Storage can be unavailable (private mode, blocked cookies).
        }
        if (theme !== 'light' && theme !== 'dark') {
          theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        root.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
