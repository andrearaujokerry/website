---
import { Font } from 'astro:assets';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { getProjects } from '../lib/content';
import { site } from '../site.config';
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/transitions.css';

interface Props {
  title?: string;
  description: string;
  /** Keep this page out of search results even after launch (the styleguide, the 404 page). */
  noindex?: boolean;
  /** Link-preview image: a slug from src/lib/og.ts, served at /og/<slug>.png. */
  image?: string;
  /** Structured data for search engines, rendered as JSON-LD. */
  jsonLd?: Record<string, unknown>;
  /** False for pages without a stable address of their own, like the 404 page. */
  canonical?: boolean;
}

const {
  title = site.name,
  description,
  noindex = false,
  image = 'home',
  jsonLd,
  canonical: hasCanonical = true,
} = Astro.props;

// Absolute URLs on the production domain, as search engines and link previews expect.
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(`/og/${image}.png`, Astro.site);
const hideFromSearch = noindex || !site.launched;
// Escape "<" so the JSON can never close its <script> tag early.
const structuredData = jsonLd && JSON.stringify(jsonLd).replaceAll('<', '\\u003c');

// The row the page transitions move along (src/styles/transitions.css): moving right is forward.
const pages = [
  '/',
  '/projects/',
  ...(await getProjects()).map((project) => `/projects/${project.id}/`),
  '/about/',
  '/resume/',
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {hasCanonical && <link rel="canonical" href={canonical} />}
    {hideFromSearch && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {hasCanonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${title}: ${description}`} />
    <meta name="twitter:card" content="summary_large_image" />
    {structuredData && <script type="application/ld+json" set:html={structuredData} />}
    <!-- Preload only what the first screen needs: the regular serif (headline) and the sans (body). -->
    <Font cssVariable="--font-serif" preload={[{ weight: 400, style: 'normal' }]} />
    <Font cssVariable="--font-sans" preload />
    <script is:inline>
      // Apply the saved theme, or the OS theme, before first paint so it never flashes.
      (() => {
        const root = document.documentElement;
        root.classList.add('js');
        let theme = null;
        try {
          theme = localStorage.getItem('theme');
        } catch {
          // Storage can be unavailable (private mode, blocked cookies).
        }
        if (theme !== 'light' && theme !== 'dark') {
          theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        root.dataset.theme = theme;
      })();
    </script>
    <script is:inline define:vars={{ pages }}>
      // Page transitions (src/styles/transitions.css). Tags each navigation with its type, from
      // where it starts and ends in `pages`, before the new page first paints. Opening or closing
      // a project also names its card's tile, so the browser can grow or shrink it.
      const path = (url) => (url ? new URL(url, location.href).pathname : '');
      const isProject = (p) => /^\/projects\/[^/]+\/$/.test(p);
      const isList = (p) => p === '/' || p === '/projects/';

      const typeOf = (from, to) => {
        const a = pages.indexOf(from);
        const b = pages.indexOf(to);
        if (a < 0 || b < 0 || a === b) return 'fade';
        if (isList(from) && isProject(to)) return 'open';
        if (isProject(from) && isList(to)) return 'close';
        const direction = b > a ? 'forward' : 'back';
        return isProject(from) && isProject(to) ? `step-${direction}` : `section-${direction}`;
      };

      let tile;
      /** Names the tile on this page's card for `project` if it's on screen; '' just clears it. */
      const nameTile = (project) => {
        if (tile) tile.style.viewTransitionName = '';
        tile = document
          .querySelector(`.project a[href="${project}"]`)
          ?.closest('.project')
          ?.querySelector('.frame');
        const box = tile?.getBoundingClientRect();
        if (box && box.bottom > 0 && box.top < innerHeight) {
          tile.style.viewTransitionName = 'project-tile';
          return true;
        }
        tile = undefined;
        return false;
      };

      // Where the last clicked link goes, for browsers without the Navigation API.
      let clicked = '';
      addEventListener('click', (event) => {
        clicked = event.target.closest?.('a[href]')?.href ?? clicked;
      });

      // The tile's colour, for the shape that grows from it or shrinks into it.
      const tileColour = () => getComputedStyle(tile).backgroundColor;
      const setTint = (colour) =>
        document.documentElement.style.setProperty('--transition-tint', colour ?? '');

      addEventListener('pageswap', (event) => {
        if (!event.viewTransition) return;
        const to = path(event.activation?.entry?.url ?? clicked);
        const opening = nameTile(typeOf(location.pathname, to) === 'open' ? to : '');
        try {
          // Always overwrite it, so a colour from an earlier visit is never reused.
          sessionStorage.setItem('transition-tint', opening ? tileColour() : '');
        } catch {
          // Without storage the shape still grows, just without its colour.
        }
      });

      addEventListener('pagereveal', (event) => {
        if (!event.viewTransition) return;
        const from = path(window.navigation?.activation?.from?.url ?? document.referrer);
        let type = typeOf(from, location.pathname);
        const tileShown = nameTile(type === 'close' ? from : '');
        // With its card off screen (or not on this page), there's nothing to close into.
        if (type === 'close' && !tileShown) type = 'section-back';
        if (type === 'close') setTint(tileColour());
        if (type === 'open') {
          try {
            setTint(sessionStorage.getItem('transition-tint'));
          } catch {
            setTint('');
          }
        }
        event.viewTransition.types?.add(type);
        document.documentElement.dataset.transition = type;
      });
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
    <div class="transition-tiles" aria-hidden="true">
      <span></span>
      <span></span>
      <span></span>
      <span></span>
    </div>
    <script>
      import '../scripts/email-links';
    </script>
  </body>
</html>
