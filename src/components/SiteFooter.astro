---
import { site } from '../site.config';
import Button from './Button.astro';

const { email } = site;
const { github, linkedin } = site.links;
const year = new Date().getFullYear();
---

<footer class="site-footer" id="contact">
  <div class="container">
    <h2 class="cta">
      Have a role or a project in mind? <em>Let's talk.</em>
    </h2>
    <div class="actions">
      {email && (
        <Button href="/#contact" data-email-user={email.user} data-email-domain={email.domain}>
          Email me <span aria-hidden="true">↗</span>
        </Button>
      )}
      {github && (
        <Button href={github} variant={email ? 'outline' : 'solid'}>
          GitHub <span aria-hidden="true">↗</span>
        </Button>
      )}
      {linkedin && (
        <Button href={linkedin} variant="outline">
          LinkedIn <span aria-hidden="true">↗</span>
        </Button>
      )}
    </div>
    <div class="colophon">
      <span>
        © {year} {site.name}
      </span>
      <nav aria-label="Footer">
        <ul class="list-plain" role="list">
          <li>
            <a href="/about/">About</a>
          </li>
          <li>
            <a href="/projects/">Projects</a>
          </li>
          {site.resume && (
            <li>
              <a href="/resume/">Résumé</a>
            </li>
          )}
        </ul>
      </nav>
      <span>Set in Instrument Serif &amp; Instrument Sans · Built with Astro</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: var(--footer-space) 3rem;
  }

  .cta {
    max-width: 58.75rem; /* 940px: two lines on desktop, as in the demo */
    font: 400 var(--text-cta) / 1 var(--font-serif);
    letter-spacing: -0.02em;
  }

  .cta em {
    color: var(--color-accent);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;
    margin-top: 2.75rem;
  }

  .colophon ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.25rem;
  }

  .colophon a {
    /* Inline padding: a 44px tap target that doesn't move the text. */
    padding-block: 0.75rem;
    text-decoration: none;
  }

  .colophon a:hover {
    color: var(--color-ink);
    text-decoration: underline;
  }

  .colophon {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.375rem 1.5rem;
    margin-top: clamp(5rem, 4rem + 4vw, 8rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-rule);
    font: 400 var(--text-label) / 1.6 var(--font-mono);
    color: var(--color-faint);
  }
</style>
