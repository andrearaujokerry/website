---
import TagList from './TagList.astro';

interface Props {
  role: string;
  company: string;
  url?: string;
  /** Display string, e.g. "Jan 2025 — Aug 2025". */
  dates: string;
  location?: string;
  summary: string;
  tech?: string[];
}

const { role, company, url, dates, location, summary, tech = [] } = Astro.props;
---

<li class="job">
  <p class="when">{dates}</p>
  <div class="role">
    <h3>{role}</h3>
    <p class="company">
      {url ? (
        <a href={url}>
          {company} <span aria-hidden="true">↗</span>
        </a>
      ) : (
        company
      )}
    </p>
    {location && <span class="location">{location}</span>}
  </div>
  <div class="detail">
    <p>{summary}</p>
    {tech.length > 0 && <TagList items={tech} />}
  </div>
</li>

<style>
  .job {
    display: grid;
    grid-template-columns: 11.875rem 20rem 1fr;
    gap: 2.25rem;
    padding-block: 2rem;
    border-bottom: 1px solid var(--color-rule);
  }

  .when {
    font: 400 var(--text-meta) / 1.9 var(--font-mono);
    color: var(--color-faint);
  }

  h3 {
    font-size: var(--text-role);
    font-weight: 600;
    line-height: 1.4;
  }

  .company {
    margin-top: 0.125rem;
    color: var(--color-muted);
  }

  .company a {
    /* Inline padding: a 44px tap target that doesn't move the text. */
    padding-block: 0.75rem;
    text-decoration-color: var(--color-rule);
  }

  .company a:hover {
    text-decoration-color: currentColor;
  }

  .location {
    display: inline-block;
    margin-top: 0.75rem;
    padding: 0.3125rem 0.5625rem;
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-pill);
    font: 400 0.75rem / 1 var(--font-mono);
    color: var(--color-faint);
  }

  .detail p {
    color: var(--color-muted);
  }

  .detail :global(.tags) {
    margin-top: 0.875rem;
  }

  @media (max-width: 47.49em) {
    .job {
      grid-template-columns: 1fr;
      gap: 0.375rem;
      padding-block: 1.625rem;
    }

    .detail {
      margin-top: 0.5rem;
    }
  }
</style>
