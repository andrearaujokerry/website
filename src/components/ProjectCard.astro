---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import TagList from './TagList.astro';

interface Props {
  title: string;
  /** Short mono label, e.g. "2024 · Live". */
  meta?: string;
  description: string;
  tech?: string[];
  /** `external` adds a decorative ↗ that screen readers skip. */
  link?: { label: string; href: string; external?: boolean };
  /** 16:10 screenshot. Without one, a tinted frame shows the project name. */
  image?: ImageMetadata;
  imageAlt?: string;
  tint?: 1 | 2 | 3 | 4;
}

const { title, meta, description, tech = [], link, image, imageAlt = '', tint = 1 } = Astro.props;
---

<article class="project">
  <div class="frame" data-tint={tint}>
    {image ? (
      <Image
        src={image}
        alt={imageAlt}
        widths={[540, 1080]}
        sizes="(min-width: 47.5em) 33rem, 100vw"
        loading="lazy"
      />
    ) : (
      <span class="placeholder" aria-hidden="true">
        {title}
      </span>
    )}
  </div>
  <div class="head">
    <h3>{title}</h3>
    {meta && <span class="meta">{meta}</span>}
  </div>
  <p class="description">{description}</p>
  <div class="foot">
    {tech.length > 0 && <TagList items={tech} />}
    {link && (
      <a href={link.href}>
        {link.label}
        {link.external && <span aria-hidden="true"> ↗</span>}
      </a>
    )}
  </div>
</article>

<style>
  .project {
    display: flex;
    flex-direction: column;
  }

  .frame {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: var(--radius-frame);
    background: var(--tint-1);
  }

  .frame[data-tint='2'] {
    background: var(--tint-2);
  }

  .frame[data-tint='3'] {
    background: var(--tint-3);
  }

  .frame[data-tint='4'] {
    background: var(--tint-4);
  }

  .frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .placeholder {
    padding: 1.5rem;
    font: italic 400 clamp(2rem, 1.5rem + 2vw, 3rem) / 1.05 var(--font-serif);
    text-align: center;
    color: color-mix(in srgb, var(--color-ink) 45%, transparent);
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    margin-top: 1.5rem;
  }

  h3 {
    font: 400 var(--text-h3) / 1.1 var(--font-serif);
    letter-spacing: -0.01em;
  }

  .meta {
    font: 400 var(--text-label) / 1.4 var(--font-mono);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--color-faint);
  }

  .description {
    max-width: 29.5rem;
    margin-block: 0.5rem 1rem;
    color: var(--color-muted);
  }

  .foot {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-top: auto;
    padding-top: 0.875rem;
    border-top: 1px solid var(--color-rule);
  }

  .foot a {
    flex: none;
    /* 44px tap target without changing the layout. */
    padding-block: 0.625rem;
    margin-block: -0.625rem;
    font-size: var(--text-small);
    font-weight: 500;
  }
</style>
