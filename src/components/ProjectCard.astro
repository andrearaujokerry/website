---
import type { ImageMetadata } from 'astro';
import ProjectFrame from './ProjectFrame.astro';
import TagList from './TagList.astro';

interface Props {
  title: string;
  /** Short mono label, e.g. "2024 · Live". */
  meta?: string;
  description: string;
  tech?: string[];
  /** Internal links get a decorative →, external ones (`external: true`) a ↗. */
  link?: { label: string; href: string; external?: boolean };
  /** 16:10 screenshot. Without one, a tinted frame shows the project name. */
  image?: ImageMetadata;
  imageAlt?: string;
  tint?: 1 | 2 | 3 | 4;
}

const { title, meta, description, tech = [], link, image, imageAlt, tint } = Astro.props;
---

<article class="project">
  <ProjectFrame title={title} image={image} imageAlt={imageAlt} tint={tint} />
  <div class="head">
    <h3>{title}</h3>
    {meta && <span class="meta">{meta}</span>}
  </div>
  <p class="description">{description}</p>
  <div class="foot">
    {tech.length > 0 && <TagList items={tech} />}
    {link && (
      <a href={link.href}>
        {link.label}
        <span aria-hidden="true">{link.external ? ' ↗' : ' →'}</span>
      </a>
    )}
  </div>
</article>

<style>
  .project {
    display: flex;
    flex-direction: column;
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    margin-top: 1.5rem;
  }

  h3 {
    font: 400 var(--text-h3) / 1.1 var(--font-serif);
    letter-spacing: -0.01em;
  }

  .meta {
    font: 400 var(--text-label) / 1.4 var(--font-mono);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--color-faint);
  }

  .description {
    max-width: 29.5rem;
    margin-block: 0.5rem 1rem;
    color: var(--color-muted);
  }

  .foot {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-top: auto;
    padding-top: 0.875rem;
    border-top: 1px solid var(--color-rule);
  }

  .foot a {
    flex: none;
    /* 44px tap target without changing the layout. */
    padding-block: 0.625rem;
    margin-block: -0.625rem;
    font-size: var(--text-small);
    font-weight: 500;
  }
</style>
