---
import { site } from '../site.config';
import ThemeToggle from './ThemeToggle.astro';

// Mark the nav item for the page being viewed (anchor links never count).
const path = Astro.url.pathname.replace(/\/?$/, '/');
const isCurrent = (href: string) => !href.includes('#') && href === path;
---

<header class="site-header">
  <div class="container">
    <div class="bar">
      <a class="wordmark" href="/">
        {site.name}
      </a>
      <button
        class="menu-button"
        type="button"
        aria-expanded="false"
        aria-controls="site-nav"
        data-menu-button
      >
        Menu
      </button>
      <nav id="site-nav" class="site-nav" aria-label="Main">
        <ul class="list-plain links" role="list">
          {site.nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))}
        </ul>
        <div class="actions">
          <ThemeToggle />
          {site.resume && (
            <a class="pill" href={site.resume}>
              Résumé <span aria-hidden="true">↗</span>
            </a>
          )}
        </div>
      </nav>
    </div>
  </div>
</header>

<script>
  // Mobile menu: a disclosure button that shows and hides the nav.
  const button = document.querySelector<HTMLButtonElement>('[data-menu-button]');
  const nav = document.getElementById('site-nav');

  if (button && nav) {
    const setOpen = (open: boolean) => {
      button.setAttribute('aria-expanded', String(open));
      nav.toggleAttribute('data-open', open);
    };
    button.addEventListener('click', () => {
      setOpen(button.getAttribute('aria-expanded') !== 'true');
    });
    nav.addEventListener('click', (event) => {
      if (event.target instanceof Element && event.target.closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && button.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        button.focus();
      }
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--color-bg);
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    min-height: var(--header-height);
    border-bottom: 1px solid var(--color-rule);
  }

  .wordmark {
    font: 400 var(--text-wordmark) / 1 var(--font-serif);
    letter-spacing: -0.005em;
    text-decoration: none;
  }

  .site-nav,
  .links,
  .actions {
    display: flex;
    align-items: center;
  }

  .site-nav {
    gap: 1.875rem;
  }

  .links {
    gap: 1.875rem;
    font-size: var(--text-small);
  }

  .links a {
    color: var(--color-muted);
    text-decoration: none;
  }

  .links a:hover {
    color: var(--color-ink);
    text-decoration: underline;
  }

  .links a[aria-current='page'] {
    color: var(--color-ink);
  }

  .actions {
    gap: 1.25rem;
  }

  .pill,
  .menu-button {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    min-height: 2.25rem;
    padding: 0.375rem 1rem;
    border: 1px solid var(--color-ink);
    border-radius: var(--radius-pill);
    background: none;
    color: var(--color-ink);
    font-size: var(--text-small);
    font-weight: 500;
    text-decoration: none;
    cursor: pointer;
  }

  .menu-button {
    display: none;
  }

  /* Touch screens: 44px tap targets. */
  @media (pointer: coarse) {
    .pill,
    .menu-button {
      min-height: 2.75rem;
    }
  }

  /* Small screens: with JavaScript the nav collapses behind "Menu"; without it, it wraps below the name. */
  @media (max-width: 47.49em) {
    .site-nav,
    .links {
      gap: 1.25rem;
    }

    :global(.js) .menu-button {
      display: inline-flex;
    }

    :global(.js) .site-nav {
      display: none;
    }

    :global(.js) .site-nav[data-open] {
      position: absolute;
      top: 100%;
      right: 0;
      left: 0;
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 1.25rem;
      padding: 1.25rem var(--gutter) 1.5rem;
      border-bottom: 1px solid var(--color-rule);
      background: var(--color-bg);
    }

    :global(.js) .site-nav[data-open] .links {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.25rem;
      font-size: 1.25rem;
    }

    :global(.js) .site-nav[data-open] .links a {
      display: block;
      padding: 0.375rem 0;
      color: var(--color-ink);
    }
  }
</style>
