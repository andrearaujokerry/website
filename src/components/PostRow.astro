---
interface Props {
  title: string;
  href: string;
  date: Date;
  /** e.g. "6 min" */
  readingTime?: string;
}

const { title, href, date, readingTime } = Astro.props;
const label = new Intl.DateTimeFormat('en-US', {
  month: 'short',
  year: 'numeric',
  timeZone: 'UTC',
}).format(date);
---

<li class="post">
  <time datetime={date.toISOString().slice(0, 10)}>{label}</time>
  <a href={href}>{title}</a>
  {readingTime && <span class="read">{readingTime}</span>}
</li>

<style>
  .post {
    display: grid;
    grid-template-columns: 11.875rem 1fr auto;
    align-items: baseline;
    gap: 2.25rem;
    padding-block: 1.75rem;
    border-bottom: 1px solid var(--color-rule);
  }

  time,
  .read {
    font: 400 var(--text-meta) / 1.4 var(--font-mono);
    color: var(--color-faint);
  }

  a {
    font: 400 var(--text-post) / 1.2 var(--font-serif);
    letter-spacing: -0.008em;
    text-decoration: none;
  }

  a:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
  }

  @media (max-width: 47.49em) {
    .post {
      grid-template-columns: 1fr auto;
      gap: 0.375rem 1rem;
      padding-block: 1.375rem;
    }

    a {
      grid-row: 2;
      grid-column: 1 / -1;
    }
  }
</style>
