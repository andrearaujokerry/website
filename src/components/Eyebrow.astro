---
interface Props {
  /** Show the green status dot (e.g. "Open to new roles"). */
  status?: boolean;
}

const { status = false } = Astro.props;
---

<p class="eyebrow">
  {status && <span class="dot" aria-hidden="true" />}
  <slot />
</p>

<style>
  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font: 500 var(--text-eyebrow) / 1.3 var(--font-mono);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .dot {
    flex: none;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--color-ok);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--color-ok) 18%, transparent);
  }
</style>
