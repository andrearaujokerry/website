---
// Typography for long-form Markdown: case studies, the About page and posts.
---

<div class="prose">
  <slot />
</div>

<style>
  .prose {
    max-width: 40rem;
    color: var(--color-muted);
  }

  .prose > :global(:first-child) {
    margin-top: 0;
  }

  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol) {
    margin-top: 1.25rem;
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.25rem;
  }

  .prose :global(li + li) {
    margin-top: 0.375rem;
  }

  .prose :global(h2) {
    margin-top: 3rem;
    font: 400 var(--text-h3) / 1.15 var(--font-serif);
    letter-spacing: -0.01em;
    color: var(--color-ink);
  }

  .prose :global(h3) {
    margin-top: 2rem;
    font-size: var(--text-role);
    font-weight: 600;
    color: var(--color-ink);
  }

  .prose :global(strong) {
    font-weight: 600;
    color: var(--color-ink);
  }

  .prose :global(a) {
    color: var(--color-ink);
    text-decoration-color: var(--color-accent);
  }

  .prose :global(blockquote) {
    margin: 2rem 0;
    padding-left: 1.25rem;
    border-left: 2px solid var(--color-accent);
    font: italic 400 var(--text-post) / 1.3 var(--font-serif);
    color: var(--color-ink);
  }

  .prose :global(img) {
    margin-block: 2rem;
    border-radius: var(--radius-frame);
  }

  .prose :global(:not(pre) > code) {
    padding: 0.1em 0.3em;
    border-radius: 3px;
    background: color-mix(in srgb, var(--color-ink) 8%, transparent);
    font: 0.9em var(--font-mono);
  }

  .prose :global(pre) {
    margin-top: 1.5rem;
    padding: 1rem 1.25rem;
    overflow-x: auto;
    border-radius: var(--radius-frame);
    font: 0.875rem / 1.6 var(--font-mono);
  }
</style>
