---
import PageIntro from '../../components/PageIntro.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProjects, projectLink, projectMeta } from '../../lib/content';
import { site } from '../../site.config';

const projects = await getProjects();
const tints = [1, 2, 3, 4] as const;
---

<BaseLayout
  title={`Projects · ${site.name}`}
  description={`Projects by ${site.name}: tools and studies built outside of work.`}
  image="projects"
>
  <div class="container">
    <PageIntro
      eyebrow="Projects"
      title={site.pages.projects.title}
      lede={site.pages.projects.lede}
    />
    <div class="projects">
      {projects.map((project, index) => (
        <ProjectCard
          title={project.data.title}
          meta={projectMeta(project.data)}
          description={project.data.description}
          tech={project.data.tech}
          link={projectLink(project)}
          image={project.data.cover}
          imageAlt={project.data.coverAlt}
          tint={tints[index % tints.length]}
          headingLevel={2}
        />
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .projects {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem 2.5rem;
    margin-top: clamp(3.25rem, 2.5071rem + 3.0476vw, 5.25rem); /* 52 → 84px */
  }

  @media (max-width: 47.49em) {
    .projects {
      grid-template-columns: 1fr;
      gap: 3.25rem;
    }
  }
</style>
