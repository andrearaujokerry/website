---
import { render } from 'astro:content';
import FactsStrip from '../../components/FactsStrip.astro';
import PageIntro from '../../components/PageIntro.astro';
import ProjectFrame from '../../components/ProjectFrame.astro';
import Prose from '../../components/Prose.astro';
import SectionHead from '../../components/SectionHead.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProjects, hasCaseStudy, statusLabel } from '../../lib/content';
import { formatRange } from '../../lib/dates';
import { site } from '../../site.config';

// One page per published project, in the same order as the projects index.
export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, index) => ({
    params: { slug: project.id },
    props: { project, previous: projects[index - 1], next: projects[index + 1] },
  }));
}

const { project, previous, next } = Astro.props;
const { data } = project;
const { Content } = await render(project);
const caseStudy = hasCaseStudy(project);

const facts = [
  { label: 'When', value: formatRange(data.start, data.end) },
  { label: 'Status', value: statusLabel(data.status) },
  { label: 'Stack', value: data.tech.join(', ') },
].filter((fact) => fact.value);

const links = [
  data.links.live && { label: 'See it live', href: data.links.live },
  data.links.source && { label: 'Source code', href: data.links.source },
].filter((link) => Boolean(link)) as { label: string; href: string }[];
---

<BaseLayout
  title={`${data.title} · ${site.name}`}
  description={data.tagline}
  image={`project-${project.id}`}
>
  <article class="container">
    <PageIntro eyebrow="Project" title={data.title} lede={data.tagline}>
      {links.length > 0 && (
        <ul class="links list-plain" role="list">
          {links.map((link) => (
            <li>
              <a href={link.href}>
                {link.label}
                <span aria-hidden="true"> ↗</span>
              </a>
            </li>
          ))}
        </ul>
      )}
    </PageIntro>

    <div class="facts">
      <FactsStrip items={facts} />
    </div>

    {data.cover && (
      <div class="cover">
        <ProjectFrame title={data.title} image={data.cover} imageAlt={data.coverAlt} size="wide" />
      </div>
    )}

    {data.highlights.length > 0 && (
      <section class="block" aria-labelledby="highlights-title">
        <SectionHead id="highlights-title" title="What I did" />
        <ol class="highlights list-plain" role="list">
          {data.highlights.map((highlight, index) => (
            <li>
              <span class="number" aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </span>
              <p>{highlight}</p>
            </li>
          ))}
        </ol>
      </section>
    )}

    {caseStudy && (
      <section class="block" aria-labelledby="case-study-title">
        <SectionHead id="case-study-title" title="Case study" />
        <div class="case-study">
          <Prose>
            <Content />
          </Prose>
        </div>
      </section>
    )}

    {(previous || next) && (
      <nav class="pager" aria-label="More projects">
        {previous && (
          <a class="previous" href={`/projects/${previous.id}/`}>
            <span class="direction">
              <span aria-hidden="true">← </span>Previous project
            </span>
            <span class="title">{previous.data.title}</span>
          </a>
        )}
        {next && (
          <a class="next" href={`/projects/${next.id}/`}>
            <span class="direction">
              Next project<span aria-hidden="true"> →</span>
            </span>
            <span class="title">{next.data.title}</span>
          </a>
        )}
      </nav>
    )}
  </article>
</BaseLayout>

<style>
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
    margin-top: 1.5rem;
    font-weight: 500;
  }

  .links a {
    padding-block: 0.75rem;
    text-underline-offset: 0.3em;
  }

  .facts {
    margin-top: clamp(2.75rem, 2.1rem + 2.6667vw, 4.5rem); /* 44 → 72px */
  }

  .cover {
    margin-top: 3rem;
  }

  .block {
    padding-top: var(--section-space);
  }

  .highlights li {
    display: grid;
    grid-template-columns: 11.875rem 1fr;
    gap: 2.25rem;
    padding-block: 1.75rem;
    border-bottom: 1px solid var(--color-rule);
  }

  .number {
    font: 400 var(--text-meta) / 1.9 var(--font-mono);
    color: var(--color-faint);
  }

  .highlights p {
    max-width: 40rem;
    color: var(--color-muted);
  }

  .case-study {
    padding-top: 2rem;
    padding-left: calc(11.875rem + 2.25rem);
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    margin-top: var(--section-space);
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-ink);
  }

  .pager a {
    display: grid;
    gap: 0.375rem;
    padding-block: 0.5rem;
    text-decoration: none;
  }

  .pager .next {
    grid-column: 2;
    text-align: right;
  }

  .direction {
    font: 500 var(--text-label) / 1.4 var(--font-mono);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-faint);
  }

  .pager .title {
    font: 400 var(--text-post) / 1.2 var(--font-serif);
  }

  .pager a:hover .title {
    text-decoration: underline;
    text-decoration-thickness: 1px;
  }

  @media (max-width: 47.49em) {
    .highlights li {
      grid-template-columns: 1fr;
      gap: 0.375rem;
      padding-block: 1.375rem;
    }

    .case-study {
      padding-left: 0;
    }

    .pager {
      grid-template-columns: 1fr;
    }

    .pager .next {
      grid-column: 1;
    }
  }
</style>
