---
import FactsStrip from '../components/FactsStrip.astro';
import Hero from '../components/Hero.astro';
import JobRow from '../components/JobRow.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SectionHead from '../components/SectionHead.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  getCertifications,
  getEducation,
  getFeaturedProjects,
  getJobs,
  projectLink,
  projectMeta,
} from '../lib/content';
import { formatMonth, formatRange } from '../lib/dates';
import { stripEmphasis } from '../lib/text';
import { site } from '../site.config';

const [jobs, education, certifications, projects] = await Promise.all([
  getJobs(),
  getEducation(),
  getCertifications(),
  getFeaturedProjects(),
]);

const years = jobs.flatMap(({ data }) => [
  data.start.getUTCFullYear(),
  data.end === 'present' ? new Date().getUTCFullYear() : data.end.getUTCFullYear(),
]);
const experienceSpan = years.length ? `${Math.min(...years)} — ${Math.max(...years)}` : undefined;
const tints = [1, 2, 3, 4] as const;
---

<!-- noindex until launch (WORKPLAN.md, Phase 7). -->
<BaseLayout description={stripEmphasis(site.intro)} noindex>
  <div class="container">
    <Hero />
    <div class="facts">
      <FactsStrip items={site.facts} />
    </div>

    <section class="block" id="work" aria-labelledby="work-title">
      <SectionHead
        id="work-title"
        title="Experience"
        note={experienceSpan}
        more={
          site.resume
            ? { label: 'Download résumé (PDF)', href: site.resume, arrow: '↓' }
            : undefined
        }
      />
      <ol class="list-plain" role="list">
        {jobs.map(({ data }) => (
          <JobRow
            role={data.role}
            company={data.company}
            url={data.url}
            dates={formatRange(data.start, data.end)}
            location={data.location}
            summary={data.summary}
            tech={data.tech}
          />
        ))}
      </ol>
    </section>

    <section class="block" id="education" aria-labelledby="education-title">
      <SectionHead id="education-title" title="Education" />
      <ol class="list-plain" role="list">
        {education.map(({ data }) => (
          <JobRow
            role={data.degree}
            company={data.school}
            dates={formatRange(data.start, data.end)}
            location={data.location}
            summary={[data.department, data.gpa && `GPA ${data.gpa}`].filter(Boolean).join(' · ')}
            tech={data.coursework}
          />
        ))}
      </ol>
      {certifications.length > 0 && (
        <div class="certs">
          <h3>Certifications</h3>
          <ul class="list-plain" role="list">
            {certifications.map(({ data }) => (
              <li>
                {data.url ? (
                  <a href={data.url}>{data.name}</a>
                ) : (
                  <span class="name">{data.name}</span>
                )}
                <span class="issuer">
                  {data.issuer}
                  {data.date && ` · ${formatMonth(data.date)}`}
                </span>
              </li>
            ))}
          </ul>
        </div>
      )}
    </section>

    <section class="block" id="projects" aria-labelledby="projects-title">
      <SectionHead
        id="projects-title"
        title="Projects"
        note="Selected"
        more={{ label: 'All projects', href: '/projects/', arrow: '→' }}
      />
      <div class="projects">
        {projects.map((project, index) => (
          <ProjectCard
            title={project.data.title}
            meta={projectMeta(project.data)}
            description={project.data.description}
            tech={project.data.tech}
            link={projectLink(project)}
            image={project.data.cover}
            imageAlt={project.data.coverAlt}
            tint={tints[index % tints.length]}
          />
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .facts {
    margin-top: clamp(3.25rem, 2.5071rem + 3.0476vw, 5.25rem); /* 52 → 84px */
  }

  .block {
    padding-top: var(--section-space);
  }

  .certs {
    display: grid;
    grid-template-columns: 11.875rem 1fr;
    gap: 2.25rem;
    padding-block: 2rem;
    border-bottom: 1px solid var(--color-rule);
  }

  .certs h3 {
    font: 400 var(--text-meta) / 1.9 var(--font-mono);
    color: var(--color-faint);
  }

  .certs ul {
    display: grid;
    gap: 0.5rem;
  }

  .certs li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.125rem 0.75rem;
  }

  .certs .name,
  .certs a {
    font-weight: 600;
  }

  .issuer {
    color: var(--color-muted);
  }

  .projects {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem 2.5rem;
    margin-top: 2.75rem;
  }

  @media (max-width: 47.49em) {
    .certs {
      grid-template-columns: 1fr;
      gap: 0.5rem;
      padding-block: 1.625rem;
    }

    .projects {
      grid-template-columns: 1fr;
      gap: 3.25rem;
      margin-top: 2rem;
    }
  }
</style>
