{
  "name": "website",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": "^22.22.3 || ^24.16.0 || >=26.3.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "astro": "astro",
    "resume:pdf": "astro build && node scripts/resume-pdf.mjs",
    "test:a11y": "node --test \"tests/**/*.test.mjs\"",
    "check:links": "node scripts/check-links.mjs",
    "check:html": "html-validate \"dist/**/*.html\"",
    "lighthouse": "lhci autorun --config=lighthouserc.cjs",
    "quality": "npm run test:a11y && npm run check:links && npm run check:html && npm run lighthouse"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@fontsource/instrument-sans": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@lhci/cli": "^0.15.1",
    "@resvg/resvg-js": "^2.6.2",
    "axe-core": "^4.14.0",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "globals": "^17.13.0",
    "html-validate": "^11.17.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "puppeteer-core": "^25.14.0",
    "satori": "^0.63.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "wrangler": "^4.150.0"
  }
}
