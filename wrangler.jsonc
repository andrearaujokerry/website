{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker's name in the Cloudflare dashboard.
  "name": "website",
  // Worker code: maintenance mode, the terminal proxy, and the static files.
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  // Build the site before every deploy and preview upload.
  "build": { "command": "npm run build" },
  // The domain, registered with Cloudflare. Each deploy attaches both hostnames, creating their DNS
  // records and certificates. A Redirect Rule in the dashboard sends www to the bare domain.
  "routes": [
    { "pattern": "andrearaujokerry.com", "custom_domain": true },
    { "pattern": "www.andrearaujokerry.com", "custom_domain": true },
  ],
  // Once routes are set, Wrangler turns these off unless they're stated. Keep the workers.dev
  // address (useful on networks that block new domains) and the branch previews.
  "workers_dev": true,
  "preview_urls": true,
  // The site itself: Astro's build output.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Unknown paths get dist/404.html (added in Phase 5) with a 404 status.
    "not_found_handling": "404-page",
    // Every request goes to worker/index.ts first, so it can hide the site (MAINTENANCE below)
    // and proxy the terminal's paths; it hands everything else to these files.
    "run_worker_first": true,
  },
  "vars": {
    // The terminal (github.com/andrearaujokerry/bloomberg) on Render, served at /projects/terminal.
    "TERMINAL_ORIGIN": "https://terminal-tbmn.onrender.com",
    // "true" hides the whole site behind an "under development" page (worker/maintenance.ts).
    // Set it to "false" to bring the site back.
    "MAINTENANCE": "true",
  },
  // Branch builds run `wrangler preview` (Worker Previews), which requires this block. Previews
  // reuse "assets" and the compatibility settings above, but NOT "vars", so repeat the ones they
  // need here. Leave MAINTENANCE out, so previews keep showing the real site.
  "previews": {
    "vars": {
      "TERMINAL_ORIGIN": "https://terminal-tbmn.onrender.com",
    },
  },
}
